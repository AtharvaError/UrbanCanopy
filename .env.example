# Supabase (from your project settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Earth Engine (pipeline)
GEE_PROJECT=ucip-mum

# Mapbox public access token (pk...), for the dashboard basemap. Optional:
# without it the map uses Esri's key-free light gray canvas. Put the real value
# in frontend/.env.local, which git ignores.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Upstash Redis, for API rate limiting (issue #101). Optional: with these unset
# the limiter is inert and every request passes, which is how the code ships
# before the store exists. Set both to turn enforcement on.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenWeatherMap API key (real-time air temperature for Nagpur)
OPENWEATHER_API_KEY=

